# The image copies only backend/src, backend/requirements*.txt, backend/constraints.txt,
# data/catalog and static. Everything else is excluded to keep the context small.

# Version control and tooling
.git
.github
.gitignore
.vscode/
.idea/
*.swp

# Secrets and local state
.env
.env*
!.env.example
**/*.db
**/*.db-journal
logs/
*.log

# Python caches and environments
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.venv/
venv/
.coverage
htmlcov/

# Not part of the backend runtime image
frontend/
docs/
loadtest/
api/
backend/tests/
backend/scripts/
README*.md
vercel.json
.vercelignore
render.yaml
Makefile
docker-compose*.yml
