# Application
APP_ENV=development
LOG_LEVEL=INFO

# Security: replace with a long random value outside local development, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite for local work; postgres:// and postgresql:// URLs are accepted too)
DATABASE_URL=sqlite+aiosqlite:///./vinfast.db
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# Browser origins allowed to call the API. "*" is rejected when APP_ENV=production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Runtime paths (defaults resolve from the repository checkout; Docker sets them explicitly)
# STATIC_DIR=../static
# SEED_DATA_DIR=../data/catalog

# Seeding: reference catalog/locations load into empty tables; demo accounts are
# created only outside production unless overridden.
# SEED_REFERENCE_DATA=true
# SEED_DEMO_ACCOUNTS=true

# Uploads
# MAX_UPLOAD_BYTES=8388608

# Optional frontend override
# VITE_API_URL=http://127.0.0.1:8000
